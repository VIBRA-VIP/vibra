# Copy to the server as `.env` next to docker-compose.prod.yml
# Do NOT commit real secrets.

POSTGRES_USER=vibra
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=vibra

API_PORT=3000
# Public URL of this API (Lightsail IP or domain). Example:
API_URL=http://YOUR_LIGHTSAIL_IP:3000
# Netlify site URL (CORS + Socket.io). Example:
WEB_URL=https://YOUR_SITE.netlify.app

JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars____
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars___
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
